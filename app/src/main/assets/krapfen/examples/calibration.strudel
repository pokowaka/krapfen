// Calibration pattern for comparing Krapfen with strudel.cc recordings.
// 10 cycles x 2 s = 20 s, synths only (no samples), sections well apart:
//   0  sine (default envelope)       1  sawtooth through lpf 1000
//   2  triangle hard left            3  square hard right
//   4  arpeggio, plucked envelope    5-6  short blip into reverb (roomsize 4)
//   7-8  short blip into delay       9  silence
setcpm(30)
arrange(
  [1, note("c4").s("sine")],
  [1, note("c4").s("sawtooth").lpf(1000)],
  [1, note("c4").s("triangle").pan(0)],
  [1, note("c4").s("square").pan(1)],
  [1, note("c4 e4 g4 c5").s("sine").attack(.01).decay(.2).sustain(0)],
  [2, note("c4 ~").s("sine").decay(.05).sustain(0).room(1).roomsize(4)],
  [2, note("c4 ~").s("sine").decay(.05).sustain(0).delay(.5).delaytime(.25).delayfeedback(.5)],
  [1, silence],
)
